{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "idecli@idecli-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jbcontext index --silent --only-incremental",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jbcontext index --silent --only-incremental",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ide search *)",
      "Bash(ide find-files *)",
      "Bash(ide find-symbol *)",
      "Bash(ide locate *)"
    ]
  }
}
